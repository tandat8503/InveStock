{
  "name": "feed-inventory-manager",
  "version": "1.0.0",
  "description": "Ứng dụng quản lý nhập xuất tồn kho thức ăn chăn nuôi",
  "homepage": "./",
  "author": "FeedStore",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:tauri": "tauri dev",
    "build": "vite build",
    "build:tauri": "tauri build",
    "build:mac": "tauri build --bundles dmg",
    "build:win": "tauri build --bundles nsis",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint src shared tests --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run build"
    ,"check:commands": "node scripts/check-command-contract.mjs"
    ,"verify:frontend": "npm run lint && npm run typecheck && npm run test && npm run check:commands && npm run build"
    ,"verify:release": "node scripts/verify-release-state.mjs && npm run verify:frontend"
    ,"package:source": "bash scripts/create-release-source.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.400.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@hookform/resolvers": "^3.6.0",
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.83.0",
    "react-router-dom": "^6.23.1",
    "recharts": "^2.12.7",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.15.7",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vitest": "^1.6.0",
    "zustand": "^4.5.2"
  }
}
